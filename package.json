{
  "name": "postman-api-testing-assignment",
  "version": "1.0.0",
  "description": "Automated REST API testing suite with Postman and Newman based on Codemify beginner tutorial",
  "scripts": {
    "test": "newman run postman_collection.json -e postman_environment.json --reporters cli",
    "test:htmlextra": "newman run postman_collection.json -e postman_environment.json -r cli,htmlextra --reporter-htmlextra-export ./newman/report.html"
  },
  "keywords": [
    "postman",
    "api-testing",
    "rest-api",
    "codemify",
    "newman",
    "automation-testing",
    "software-qa"
  ],
  "author": "Student",
  "license": "MIT",
  "devDependencies": {
    "newman": "^6.1.3",
    "newman-reporter-htmlextra": "^1.23.1"
  }
}
