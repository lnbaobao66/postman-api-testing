{
	"info": {
		"_postman_id": "b8a3e951-41d3-4f9e-a812-78d10b7b12cd",
		"name": "Restful Booker API Testing - Codemify Suite",
		"description": "Bộ sưu tập kiểm thử tự động toàn diện REST API cho Restful Booker dựa trên kiến thức video Codemify Postman Beginner Tutorial. Bao gồm trọn vẹn quy trình CRUD, API Chaining, Dynamic Variables, Assertion Scripts, Negative Testing và Data Validation.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "01 - Authentication",
			"item": [
				{
					"name": "Create Auth Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Test 1: Kiểm tra HTTP Status Code là 200 OK",
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"// Test 2: Kiểm tra thời gian phản hồi (Response Time) < 2000ms",
									"pm.test(\"Response time is less than 2000ms\", function () {",
									"    pm.expect(pm.response.responseTime).to.be.below(2000);",
									"});",
									"",
									"// Test 3: Kiểm tra Response Body có chứa token và token là chuỗi ký tự hợp lệ",
									"const jsonData = pm.response.json();",
									"pm.test(\"Response contains a valid auth token\", function () {",
									"    pm.expect(jsonData).to.have.property('token');",
									"    pm.expect(jsonData.token).to.be.a('string');",
									"    pm.expect(jsonData.token.length).to.be.greaterThan(0);",
									"});",
									"",
									"// API Chaining: Lưu token vào Environment Variable để các request sau sử dụng",
									"pm.environment.set(\"token\", jsonData.token);",
									"console.log(\"Saved Auth Token to Environment:\", jsonData.token);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"admin\",\n    \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth"
							]
						},
						"description": "Tạo Token xác thực quyền Admin để sử dụng cho các thao tác cập nhật (PUT, PATCH) và xóa (DELETE)."
					},
					"response": []
				}
			],
			"description": "Thư mục chứa các API xác thực người dùng và phân quyền."
		},
		{
			"name": "02 - Booking Management (CRUD)",
			"item": [
				{
					"name": "Get All Bookings",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Test 1: Kiểm tra Status Code",
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"// Test 2: Kiểm tra định dạng dữ liệu trả về là Mảng (Array)",
									"const jsonData = pm.response.json();",
									"pm.test(\"Response is an array of bookings\", function () {",
									"    pm.expect(jsonData).to.be.an('array');",
									"    pm.expect(jsonData.length).to.be.greaterThan(0);",
									"});",
									"",
									"// Test 3: Kiểm tra cấu trúc phần tử đầu tiên phải có trường bookingid",
									"pm.test(\"Each booking object has bookingid\", function () {",
									"    pm.expect(jsonData[0]).to.have.property('bookingid');",
									"    pm.expect(jsonData[0].bookingid).to.be.a('number');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/booking",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"booking"
							]
						},
						"description": "Lấy danh sách tất cả các ID đặt phòng hiện có trong hệ thống."
					},
					"response": []
				},
				{
					"name": "Create New Booking",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Pre-request Script: Khởi tạo giá trị ngẫu nhiên để tránh trùng lặp dữ liệu",
									"const randomPrice = Math.floor(Math.random() * 500) + 100;",
									"pm.environment.set(\"dynamic_price\", randomPrice);",
									"console.log(\"Generated dynamic totalprice:\", randomPrice);"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Test 1: Kiểm tra Status Code 200 OK",
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"// Test 2: Kiểm tra cấu trúc Response Body",
									"const jsonData = pm.response.json();",
									"pm.test(\"Response contains bookingid and booking object\", function () {",
									"    pm.expect(jsonData).to.have.property('bookingid');",
									"    pm.expect(jsonData).to.have.property('booking');",
									"    pm.expect(jsonData.bookingid).to.be.a('number');",
									"});",
									"",
									"// Test 3: Kiểm tra tính toàn vẹn của dữ liệu vừa gửi đi",
									"pm.test(\"Booking details match submitted data\", function () {",
									"    pm.expect(jsonData.booking.firstname).to.eql(pm.environment.get(\"firstname\"));",
									"    pm.expect(jsonData.booking.lastname).to.eql(pm.environment.get(\"lastname\"));",
									"    pm.expect(jsonData.booking.depositpaid).to.eql(true);",
									"});",
									"",
									"// API Chaining: Lưu bookingid vào biến môi trường để sử dụng cho GET/PUT/DELETE",
									"pm.environment.set(\"bookingId\", jsonData.bookingid);",
									"console.log(\"Saved new Booking ID to Environment:\", jsonData.bookingid);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"firstname\": \"{{firstname}}\",\n    \"lastname\": \"{{lastname}}\",\n    \"totalprice\": {{dynamic_price}},\n    \"depositpaid\": true,\n    \"bookingdates\": {\n        \"checkin\": \"2026-11-01\",\n        \"checkout\": \"2026-11-10\"\n    },\n    \"additionalneeds\": \"Breakfast and Airport Shuttle\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/booking",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"booking"
							]
						},
						"description": "Tạo một bản ghi booking mới. Tự động lưu bookingid vào biến môi trường `bookingId`."
					},
					"response": []
				},
				{
					"name": "Get Booking By ID",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Test 1: Kiểm tra Status Code",
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"// Test 2: Kiểm tra Content-Type Header là application/json",
									"pm.test(\"Content-Type header is application/json\", function () {",
									"    pm.response.to.have.header(\"Content-Type\");",
									"    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
									"});",
									"",
									"// Test 3: Kiểm tra nội dung chi tiết của bản ghi khớp với biến môi trường",
									"const jsonData = pm.response.json();",
									"pm.test(\"Booking firstname matches created value\", function () {",
									"    pm.expect(jsonData.firstname).to.eql(pm.environment.get(\"firstname\"));",
									"    pm.expect(jsonData.lastname).to.eql(pm.environment.get(\"lastname\"));",
									"});",
									"",
									"// Test 4: Kiểm tra ngày checkin và checkout hợp lệ",
									"pm.test(\"Booking dates are valid strings\", function () {",
									"    pm.expect(jsonData.bookingdates.checkin).to.be.a('string');",
									"    pm.expect(jsonData.bookingdates.checkout).to.be.a('string');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/booking/{{bookingId}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"booking",
								"{{bookingId}}"
							]
						},
						"description": "Truy xuất thông tin chi tiết của booking vừa được tạo thông qua `{{bookingId}}`."
					},
					"response": []
				},
				{
					"name": "Update Booking (Full Update - PUT)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Test 1: Kiểm tra Status Code 200 OK",
									"pm.test(\"Status code is 200 OK after full update\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"// Test 2: Kiểm tra các trường dữ liệu đã được cập nhật thành công",
									"const jsonData = pm.response.json();",
									"pm.test(\"Updated firstname and additionalneeds are saved\", function () {",
									"    pm.expect(jsonData.firstname).to.eql(\"Alexander\");",
									"    pm.expect(jsonData.lastname).to.eql(\"Miller - VIP\");",
									"    pm.expect(jsonData.additionalneeds).to.eql(\"Late Check-out and Sea View Room\");",
									"    pm.expect(jsonData.totalprice).to.eql(999);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Cookie",
								"value": "token={{token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"firstname\": \"Alexander\",\n    \"lastname\": \"Miller - VIP\",\n    \"totalprice\": 999,\n    \"depositpaid\": true,\n    \"bookingdates\": {\n        \"checkin\": \"2026-11-01\",\n        \"checkout\": \"2026-11-15\"\n    },\n    \"additionalneeds\": \"Late Check-out and Sea View Room\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/booking/{{bookingId}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"booking",
								"{{bookingId}}"
							]
						},
						"description": "Cập nhật toàn bộ thông tin bản ghi booking bằng phương thức PUT kết hợp Token xác thực trong Cookie header."
					},
					"response": []
				},
				{
					"name": "Partial Update Booking (PATCH)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Test 1: Kiểm tra Status Code 200 OK",
									"pm.test(\"Status code is 200 OK after PATCH\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"// Test 2: Kiểm tra chỉ trường giá và firstname được cập nhật",
									"const jsonData = pm.response.json();",
									"pm.test(\"Patched fields are updated correctly\", function () {",
									"    pm.expect(jsonData.firstname).to.eql(\"Alex-Updated\");",
									"    pm.expect(jsonData.totalprice).to.eql(1250);",
									"    // Các trường khác vẫn giữ nguyên",
									"    pm.expect(jsonData.lastname).to.eql(\"Miller - VIP\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Cookie",
								"value": "token={{token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"firstname\": \"Alex-Updated\",\n    \"totalprice\": 1250\n}"
						},
						"url": {
							"raw": "{{base_url}}/booking/{{bookingId}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"booking",
								"{{bookingId}}"
							]
						},
						"description": "Cập nhật một phần thuộc tính của booking bằng phương thức PATCH."
					},
					"response": []
				},
				{
					"name": "Delete Booking",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Test 1: Restful Booker trả về mã 201 Created khi xóa thành công",
									"pm.test(\"Status code is 201 Created on successful deletion\", function () {",
									"    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
									"});",
									"",
									"// Test 2: Kiểm tra Body trả về chuỗi thông báo 'Created'",
									"pm.test(\"Response body confirms deletion\", function () {",
									"    pm.expect(pm.response.text()).to.include(\"Created\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Cookie",
								"value": "token={{token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/booking/{{bookingId}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"booking",
								"{{bookingId}}"
							]
						},
						"description": "Xóa bản ghi booking theo `{{bookingId}}` sử dụng Token xác thực."
					},
					"response": []
				}
			],
			"description": "Thư mục quản lý các hoạt động nghiệp vụ CRUD của Booking."
		},
		{
			"name": "03 - Negative & Edge Cases Testing",
			"item": [
				{
					"name": "Verify Booking Has Been Deleted (404 Not Found)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Test 1: Kiểm tra Status Code phải là 404 Not Found",
									"pm.test(\"Status code is 404 Not Found after deletion\", function () {",
									"    pm.response.to.have.status(404);",
									"});",
									"",
									"// Test 2: Kiểm tra Response Body trả về Not Found",
									"pm.test(\"Response body indicates Not Found\", function () {",
									"    pm.expect(pm.response.text()).to.include(\"Not Found\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/booking/{{bookingId}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"booking",
								"{{bookingId}}"
							]
						},
						"description": "Kiểm tra tính toàn vẹn: Truy vấn lại bản ghi vừa bị xóa, hệ thống phải trả về lỗi 404 Not Found."
					},
					"response": []
				},
				{
					"name": "Negative Test - Unauthorized Update (403 Forbidden)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Test 1: Kiểm tra Status Code là 403 Forbidden khi thiếu token hợp lệ",
									"pm.test(\"Status code is 403 Forbidden without valid token\", function () {",
									"    pm.response.to.have.status(403);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Cookie",
								"value": "token=INVALID_TOKEN_12345"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"firstname\": \"Hacker\",\n    \"lastname\": \"Attempt\",\n    \"totalprice\": 0,\n    \"depositpaid\": false,\n    \"bookingdates\": {\n        \"checkin\": \"2026-11-01\",\n        \"checkout\": \"2026-11-02\"\n    },\n    \"additionalneeds\": \"None\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/booking/1",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"booking",
								"1"
							]
						},
						"description": "Kiểm thử bảo mật tiêu cực: Cố ý gửi token giả mạo để kiểm tra hệ thống có chặn và trả về 403 Forbidden hay không."
					},
					"response": []
				}
			],
			"description": "Thư mục kiểm thử trường hợp ngoại lệ, bảo mật và tính toàn vẹn dữ liệu."
		}
	],
	"variable": [
		{
			"key": "collection_name",
			"value": "Codemify Postman Testing Assignment",
			"type": "string"
		}
	]
}
